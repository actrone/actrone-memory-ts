{
  "name": "@actrone/memory",
  "version": "0.1.0",
  "description": "Two-tier persistent agent memory for TypeScript/JS: short-term session turns + long-term semantic recall, with a pluggable store (in-memory default, Redis/Qdrant adapters) and embeddings. The open-source on-ramp to Actrone's governed hosted memory.",
  "license": "MIT",
  "author": "Actrone",
  "homepage": "https://actrone.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/actrone/actrone-memory-ts.git"
  },
  "bugs": {
    "url": "https://github.com/actrone/actrone-memory-ts/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters.d.ts",
      "import": "./dist/adapters.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "actrone-memory": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "docs:api": "typedoc",
    "typecheck:examples": "tsc -p examples/tsconfig.json",
    "snippets": "node scripts/extract-snippets.mjs",
    "snippets:check": "node scripts/extract-snippets.mjs --check",
    "check-compat": "node scripts/check-compat.mjs"
  },
  "keywords": [
    "ai",
    "agents",
    "llm",
    "memory",
    "rag",
    "vector",
    "actrone"
  ],
  "dependencies": {
    "zod": "4.4.3"
  },
  "//peerDependencies": "Framework adapters (src/adapters.ts) are structural — none is imported at runtime. These optional peers only make the version each recipe is tested against machine-legible so npm warns on a mismatch; install just the one your app uses.",
  "peerDependencies": {
    "fastembed": ">=2 <3",
    "@anthropic-ai/claude-agent-sdk": ">=0.1.0 <1",
    "@inngest/agent-kit": ">=0.5.0 <1",
    "@langchain/core": ">=0.2.0 <2",
    "@langchain/langgraph": ">=0.1.0 <2",
    "@mastra/core": ">=0.10.0 <1",
    "@openai/agents": ">=0.1.0 <1",
    "@voltagent/core": ">=0.1.0 <2",
    "agents": ">=0.0.1 <1",
    "ai": ">=5.0.0 <6",
    "genkit": ">=1.0.0 <2",
    "llamaindex": ">=0.8.0 <1"
  },
  "peerDependenciesMeta": {
    "fastembed": {
      "optional": true
    },
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "@inngest/agent-kit": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    },
    "@langchain/langgraph": {
      "optional": true
    },
    "@mastra/core": {
      "optional": true
    },
    "@openai/agents": {
      "optional": true
    },
    "@voltagent/core": {
      "optional": true
    },
    "agents": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "genkit": {
      "optional": true
    },
    "llamaindex": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "25.9.3",
    "tsup": "8.5.1",
    "typedoc": "^0.28.20",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  }
}

{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "types": ["node"],
    "outDir": "dist",
    // The package is bundled by tsup (entry-based, `dts: true`); tsc is never run to emit
    // from this config, so `rootDir` is only used for the IDE's program shape. It must be the
    // repo-package root (".") — not "src" — so the co-located `test/` files (which the IDE
    // type-checks) don't trip TS6059 "not under rootDir". `noEmit` makes that explicit and
    // guards against an accidental `tsc -p tsconfig.json` emitting test files into dist.
    "rootDir": ".",
    "noEmit": true
  },
  "include": ["src", "test"],
  "exclude": ["dist", "node_modules"]
}
